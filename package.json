  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm run build",
    "ops:doctor": "node scripts/ops-cli.mjs doctor",
    "ops:supabase": "node scripts/ops-cli.mjs supabase",
    "ops:cf": "node scripts/ops-cli.mjs cf",
    "db:push": "node --env-file=.env scripts/push-supabase-schema.mjs",
    "db:verify": "node --env-file=.env scripts/verify-supabase-live.mjs --database"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "supabase": "^3.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.164.0"
  }
}
