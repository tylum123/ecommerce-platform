# =============================================================================
# Hasaki Clone Environment Variables Configuration
# =============================================================================

# Server Port
PORT=3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database Architecture (Hybrid PostgreSQL / Embedded SQLite)
# -----------------------------------------------------------------------------
# If DATABASE_URL is set, the application uses external PostgreSQL.
# If DATABASE_URL is empty or not set, it seamlessly uses embedded SQLite.
# DATABASE_URL=postgresql://hasaki:hasaki_secret_2026@localhost:5432/hasaki_db?schema=public

# Optional SQLite DB Path override (defaults to OS temp directory or local store)
# SQLITE_DB_PATH=./data/hasaki.db

# Seed Data Switch:
# When true (or omitted), sample Hasaki catalog, branches, and clinic services are available.
# When false (or toggled via /api/erp action=toggle_seed_data), only proprietary custom products are visible.
SEED_HASAKI_DATA=true

# -----------------------------------------------------------------------------
# Authentication & Server-Side Signed Session
# -----------------------------------------------------------------------------
# Secret key used for HMAC-SHA256 signing of the HTTP-only hasaki_session cookie.
SESSION_SECRET=hasaki_super_secure_session_secret_change_in_production_2026

# Session Time-To-Live in seconds (default: 7 days = 604800)
SESSION_MAX_AGE_SECONDS=604800

# -----------------------------------------------------------------------------
# VietQR Dynamic Payment Gateway
# -----------------------------------------------------------------------------
# Bank ID according to NAPAS VietQR specification (e.g. MB, VCB, TCB, ACB, VPB)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0901234567
VIETQR_ACCOUNT_NAME=CONG TY CO PHAN HASAKI BEAUTY AND CLINIC
VIETQR_TEMPLATE=compact2

# -----------------------------------------------------------------------------
# Payment Webhook Verification Secrets (VNPAY / MoMo / VietQR)
# -----------------------------------------------------------------------------
VNPAY_TMN_CODE=HASAKI01
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
MOMO_PARTNER_CODE=MOMO_HASAKI
MOMO_SECRET_KEY=your_momo_secret_key_here
