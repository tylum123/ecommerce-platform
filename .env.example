VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0901234567"
VIETQR_ACCOUNT_NAME="CONG TY CO PHAN MY PHAM NARI HOME"
VIETQR_TEMPLATE="compact2"

