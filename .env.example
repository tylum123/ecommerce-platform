# ============================================================================
# 1. DATABASE PUSH & POSTGRESQL
# ============================================================================
# [Required khi NARI_CATALOG_BACKEND="postgres" hoặc chạy migration/push PostgreSQL]
# Chuỗi kết nối PostgreSQL của Supabase (không kèm query string như ?sslmode=...).
# Lấy tại: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Ví dụ: postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
NARI_POSTGRES_URL=""

# [Optional] Chế độ TLS kết nối PostgreSQL: "verify-full" (mặc định) hoặc "disable" (chỉ cho localhost ngoài production).
NARI_POSTGRES_SSL_MODE="verify-full"

# [Optional] Chứng chỉ CA tùy chỉnh (chuỗi PEM) nếu server PostgreSQL yêu cầu custom CA.
NARI_POSTGRES_CA=""

# [Optional] Số kết nối tối đa trong pool PostgreSQL (1 - 20, mặc định: "5").
NARI_POSTGRES_POOL_MAX="5"

# ============================================================================
# 2. SUPABASE AUTH & SESSION
# ============================================================================
# [Optional] Bật luồng đăng nhập preview cục bộ qua Supabase Auth ("true" | "false", mặc định: "false").
# Lưu ý: Production luôn từ chối luồng preview này cho đến khi có shared rate limiter.
NARI_AUTH_ENABLED="false"

# [Required khi NARI_AUTH_ENABLED="true" hoặc dùng Storage upload]
# URL HTTPS của Supabase Project (không có dấu / ở cuối, không có path/query).
# Lấy tại: Supabase Dashboard -> Project Settings -> API (Data API) -> Project URL
NEXT_PUBLIC_SUPABASE_URL=""

# [Required khi NARI_AUTH_ENABLED="true"]
# Publishable key của Supabase (định dạng sb_publishable_..., an toàn cho phía client).
# Lấy tại: Supabase Dashboard -> Project Settings -> API Keys -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# [Required khi NARI_AUTH_ENABLED="true"]
# Origin chính xác của ứng dụng (không có dấu / ở cuối) dùng để kiểm tra CSRF Origin và cookie Secure.
# Development: "http://localhost:3010" | Production: "https://ten-mien-cua-ban.vn"
APP_ORIGIN="http://localhost:3010"

# ============================================================================
# 3. SUPABASE STORAGE
# ============================================================================
# [Required khi dùng API upload ảnh /api/admin/upload]
# Phải trùng khớp hoàn toàn với NEXT_PUBLIC_SUPABASE_URL (chỉ dùng phía server).
# Lấy tại: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=""

# [Required khi dùng API upload ảnh /api/admin/upload]
# Service Role / Secret Key của Supabase (CHỈ DÙNG SERVER, TUYỆT ĐỐI KHÔNG gắn tiền tố NEXT_PUBLIC_).
# Lấy tại: Supabase Dashboard -> Project Settings -> API Keys -> Secret keys / service_role
SUPABASE_SERVICE_ROLE_KEY=""

# [Required khi dùng API upload ảnh /api/admin/upload]
# Tên bucket public đã tạo sẵn trên Supabase Storage (ví dụ: "nari-catalog").
# Lấy tại: Supabase Dashboard -> Storage -> Buckets
NARI_STORAGE_BUCKET=""

# [Required khi dùng API upload ảnh /api/admin/upload]
# Origin HTTPS công khai của Storage, phải trùng với origin HTTPS của Supabase project.
# Ví dụ: "https://[PROJECT_REF].supabase.co"
NARI_STORAGE_PUBLIC_ORIGIN=""

# ============================================================================
# 4. RUNTIME BACKEND & FEATURE FLAGS
# ============================================================================
# [Required] Backend dữ liệu chính của catalog ("postgres").
NARI_CATALOG_BACKEND="postgres"

# [Optional] Backend lưu trữ shared rate limit cho Auth / API nhạy cảm ("postgres" | "memory", mặc định: "postgres").
NARI_SHARED_RATE_LIMIT="postgres"

# [Optional] Bật luồng đặt hàng trực tuyến trên PostgreSQL ("true" | "false", mặc định: "false").
NARI_ORDERS_ENABLED="false"

# [Optional] Bật API quản trị catalog trên PostgreSQL ("true" | "false", mặc định: "false").
# Yêu cầu NARI_CATALOG_BACKEND="postgres", NARI_AUTH_ENABLED="true" và cấu hình PostgreSQL hợp lệ.
NARI_CATALOG_ADMIN_ENABLED="false"

# [Optional] Cổng nhân viên chỉ xem màn hình; không mở API/tác vụ ERP.
# Yêu cầu Supabase Auth + PostgreSQL identity được cấp quyền ở server.
NARI_STAFF_PORTAL_ENABLED="false"

# [Optional] Bật API quản trị ERP (Khách hàng CRM, Nhân sự, Đơn hàng, Tồn kho) trên PostgreSQL ("true" | "false", mặc định: "false").
NARI_ERP_ADMIN_ENABLED="false"

# [Optional] Bật cổng nhận webhook xác nhận thanh toán tự động trên PostgreSQL ("true" | "false", mặc định: "false").
NARI_PAYMENT_WEBHOOK_ENABLED="false"

# [Required khi NARI_PAYMENT_WEBHOOK_ENABLED="true"] Bí mật HMAC-SHA256 (>= 16 ký tự) dùng xác thực chữ ký webhook (CHỈ DÙNG SERVER).
NARI_PAYMENT_WEBHOOK_SECRET=""

# ============================================================================
# 5. SUPABASE CLI & CLOUDFLARE WRANGLER OPS
# ============================================================================
# [Optional] Supabase Project Ref dùng cho scripts/ops-cli.mjs và supabase/config.toml.
SUPABASE_PROJECT_REF="ywrzguhuzekkusoupehf"

# [Optional] Supabase Personal Access Token (sbp_...) dùng cho Supabase CLI (CHỈ DÙNG LOCAL/CI, KHÔNG ĐƯA VÀO CLIENT).
SUPABASE_ACCESS_TOKEN=""

# [Optional] Cloudflare Account ID dùng cho Wrangler CLI.
CLOUDFLARE_ACCOUNT_ID=""

# [Optional] Cloudflare API Token dùng cho Wrangler CLI (CHỈ DÙNG LOCAL/CI, KHÔNG ĐƯA VÀO CLIENT).
CLOUDFLARE_API_TOKEN=""

# ============================================================================
